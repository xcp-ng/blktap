[Unit]
Description=Tapback daemon for blktap3
After=syslog.target network.target xenstored.service
Requires=xenstored.service

[Service]
Type=forking
EnvironmentFile=-/etc/sysconfig/tapback
ExecStart=/usr/bin/tapback -p /var/run/tapback.pid $TAPBACK_OPTS
PIDFile = /var/run/tapback.pid

[Install]
WantedBy=multi-user.target
